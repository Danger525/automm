# ============================================================
# Discord Bot Settings
# ============================================================
DISCORD_TOKEN=
MIDDLEMAN_ROLE_ID=0
TICKET_CATEGORY_ID=0
TRANSCRIPT_CHANNEL_ID=0

# ============================================================
# AutoMM Crypto Escrow Backend Settings
# ============================================================
# Database connection string (SQLite async by default; or PostgreSQL via asyncpg)
DATABASE_URL=sqlite+aiosqlite:///./escrow.db

# Blockchain EVM Testnet (Default: Ethereum Sepolia or Polygon Amoy)
BLOCKCHAIN_NETWORK=SEPOLIA
CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Number of block confirmations required to transition deal to FUNDED
CONFIRMATION_THRESHOLD=2

# Monitor poll interval in seconds
POLL_INTERVAL_SECONDS=8

# Asset Configuration (None for native currency like Sepolia ETH or Amoy POL)
SUPPORTED_TOKEN_SYMBOL=ETH
SUPPORTED_TOKEN_ADDRESS=
SUPPORTED_TOKEN_DECIMALS=18

# AES-256 Fernet base64 32-byte key used to encrypt escrow private keys at rest
ESCROW_ENCRYPTION_KEY=gH8K_yZ9gV8qL1W2e3R4t5Y6u7I8o9P0a1S2d3F4g5H=

# AutoMM Backend API URL
AUTOMM_API_URL=http://127.0.0.1:8000/api/v1

# Admin secret key for dispute refunds and protected endpoints
BACKEND_SECRET=automm-dev-secret-key-change-in-production
