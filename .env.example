# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=

# Role ID for Middleman / Escrow Staff (set to 0 if not used)
MIDDLEMAN_ROLE_ID=0

# Category ID where new deal tickets should be created (set to 0 for root)
